---
import { calculateFreelanceRate } from "@repo/calculators/freelance-rate";
import { buildMeta } from "@repo/seo";
import { formatCurrency, formatNumber } from "@repo/ui";
import AdSlot from "@repo/ui/components/AdSlot.astro";
import FaqList from "@repo/ui/components/FaqList.astro";
import Layout from "@repo/ui/components/Layout.astro";
import NextStep from "@repo/ui/components/NextStep.astro";
import { siteConfig } from "../../site.config";
import MoreTools from "../components/MoreTools.astro";
import { footerColumns, footerTagline, navItems } from "../site-nav";
import { formatUpdated, getTool, toolStructuredData } from "../tools";

const tool = getTool("/freelance-hourly-rate");

const meta = buildMeta(siteConfig, {
  title: "Freelance Hourly Rate Calculator (After Tax & Expenses)",
  description:
    "Free freelance rate calculator: enter the take-home income you want, your expenses, tax rate and billable hours to get the hourly and day rate you need to charge.",
  path: tool.href,
});

const defaults = {
  targetIncome: 75000,
  annualExpenses: 10000,
  taxRatePercent: 25,
  billableHoursPerWeek: 25,
  weeksPerYear: 46,
};

function rateAt(hours: number) {
  const result = calculateFreelanceRate({ ...defaults, billableHoursPerWeek: hours });
  if (!result.ok) throw new Error("Default freelance-rate inputs must be valid");
  return result.data;
}

const seed = rateAt(defaults.billableHoursPerWeek);
const salaryRate = defaults.targetIncome / 2080;
const scenarioHours = [20, 30, 35];

const presets = [
  { label: "Designer", values: { targetIncome: 70000, annualExpenses: 6000, taxRatePercent: 25, billableHoursPerWeek: 25, weeksPerYear: 46 } },
  { label: "Developer", values: { targetIncome: 120000, annualExpenses: 9000, taxRatePercent: 30, billableHoursPerWeek: 30, weeksPerYear: 46 } },
  { label: "Part-time side gig", values: { targetIncome: 20000, annualExpenses: 1500, taxRatePercent: 20, billableHoursPerWeek: 10, weeksPerYear: 48 } },
];

const faqs = [
  {
    question: "How do I calculate my freelance hourly rate?",
    answer:
      "Work out the revenue you need — your take-home income grossed up for tax, plus business expenses — and divide it by the hours you can actually bill in a year. With $75,000 take-home, a 25% tax rate and $10,000 of expenses, you need $110,000 of revenue; across 1,150 billable hours that's about $95.65 an hour.",
  },
  {
    question: "Why not just divide my old salary by 2,080 hours?",
    answer:
      "Because 2,080 assumes 40 billable hours every week of the year. Freelancers spend a large share of their time on sales, admin, and unpaid gaps between projects, take holidays without pay, and cover their own taxes and expenses. That's why freelance rates are typically well above the salary-equivalent hourly figure.",
  },
  {
    question: "How many billable hours per week is realistic?",
    answer:
      "It varies, but many full-time freelancers bill somewhere between 20 and 30 hours a week once marketing, admin, and client communication are accounted for. If you're unsure, start lower — overestimating billable hours is the most common way to underprice.",
  },
  {
    question: "What tax rate should I use?",
    answer:
      "Use your best estimate of the combined rate on your business profit, including income tax and any self-employment or social-security contributions where you live. This calculator applies one flat rate as an estimate; it isn't tax advice, and an accountant can give you a precise figure.",
  },
  {
    question: "What goes into business expenses?",
    answer:
      "Everything you pay to run the business that an employer would otherwise cover: software, equipment, insurance, health cover, accounting fees, coworking or home-office costs, training, and retirement contributions you want to fund.",
  },
];

const structuredData = toolStructuredData(tool, meta.description);
---

<Layout
  config={siteConfig}
  meta={meta}
  structuredData={structuredData}
  navItems={navItems}
  footerColumns={footerColumns}
  footerTagline={footerTagline}
>
  <div class="page-header">
    <h1 class="page-title">{tool.name}</h1>
    <p class="lede">
      Hourly rate = (take-home income ÷ (1 − tax rate) + expenses) ÷ billable hours per year. Enter what
      you want to earn and how much you can really bill to get the rate that pays it.
    </p>
    <p class="page-meta">Updated <time datetime={tool.updated}>{formatUpdated(tool.updated)}</time> · An estimate using one flat tax rate — not tax advice.</p>
  </div>

  <div class="calc-grid">
    <form id="calc-form" class="panel" novalidate>
      <div class="preset-row">
        <span class="preset-label">Try an example</span>
        {
          presets.map((preset) => (
            <button type="button" class="preset" data-preset={JSON.stringify(preset.values)} aria-pressed="false">
              {preset.label}
            </button>
          ))
        }
      </div>

      <div class="field-stack">
        <div class="field">
          <label for="targetIncome">Take-home income you want (per year)</label>
          <div class="input-row">
            <button type="button" class="stepper" data-step-for="targetIncome" data-step-delta="-5000" aria-label="Decrease income by 5,000">−</button>
            <div class="input-affix">
              <span class="affix affix-start" aria-hidden="true">$</span>
              <input type="number" id="targetIncome" name="targetIncome" min="0" max="10000000" step="100" value={defaults.targetIncome} inputmode="decimal" />
            </div>
            <button type="button" class="stepper" data-step-for="targetIncome" data-step-delta="5000" aria-label="Increase income by 5,000">+</button>
          </div>
        </div>

        <div class="field">
          <label for="annualExpenses">Business expenses (per year)</label>
          <div class="input-row">
            <button type="button" class="stepper" data-step-for="annualExpenses" data-step-delta="-1000" aria-label="Decrease expenses by 1,000">−</button>
            <div class="input-affix">
              <span class="affix affix-start" aria-hidden="true">$</span>
              <input type="number" id="annualExpenses" name="annualExpenses" min="0" max="10000000" step="100" value={defaults.annualExpenses} inputmode="decimal" aria-describedby="annualExpenses-hint" />
            </div>
            <button type="button" class="stepper" data-step-for="annualExpenses" data-step-delta="1000" aria-label="Increase expenses by 1,000">+</button>
          </div>
          <span class="field-hint" id="annualExpenses-hint">Software, equipment, insurance, health cover, accounting.</span>
        </div>

        <div class="field">
          <label for="taxRatePercent">Estimated tax rate</label>
          <div class="input-row">
            <button type="button" class="stepper" data-step-for="taxRatePercent" data-step-delta="-1" aria-label="Decrease tax rate by 1 percent">−</button>
            <div class="input-affix">
              <span class="affix affix-end" aria-hidden="true">%</span>
              <input type="number" id="taxRatePercent" name="taxRatePercent" min="0" max="90" step="1" value={defaults.taxRatePercent} inputmode="decimal" />
            </div>
            <button type="button" class="stepper" data-step-for="taxRatePercent" data-step-delta="1" aria-label="Increase tax rate by 1 percent">+</button>
          </div>
        </div>

        <div class="field">
          <label for="billableHoursPerWeek">Billable hours per week</label>
          <div class="input-row">
            <button type="button" class="stepper" data-step-for="billableHoursPerWeek" data-step-delta="-1" aria-label="Decrease billable hours by 1">−</button>
            <div class="input-affix">
              <input type="number" id="billableHoursPerWeek" name="billableHoursPerWeek" min="1" max="100" step="1" value={defaults.billableHoursPerWeek} inputmode="decimal" aria-describedby="billable-hint" />
            </div>
            <button type="button" class="stepper" data-step-for="billableHoursPerWeek" data-step-delta="1" aria-label="Increase billable hours by 1">+</button>
          </div>
          <span class="field-hint" id="billable-hint">Hours you can charge for — not hours you work.</span>
        </div>

        <div class="field">
          <label for="weeksPerYear">Working weeks per year</label>
          <div class="input-row">
            <button type="button" class="stepper" data-step-for="weeksPerYear" data-step-delta="-1" aria-label="Decrease working weeks by 1">−</button>
            <div class="input-affix">
              <input type="number" id="weeksPerYear" name="weeksPerYear" min="1" max="52" step="1" value={defaults.weeksPerYear} inputmode="decimal" aria-describedby="weeks-hint" />
            </div>
            <button type="button" class="stepper" data-step-for="weeksPerYear" data-step-delta="1" aria-label="Increase working weeks by 1">+</button>
          </div>
          <span class="field-hint" id="weeks-hint">52 minus holidays, vacation, and sick time.</span>
        </div>
      </div>

      <ul id="form-errors" class="error-list" aria-live="polite"></ul>

      <button type="button" class="copy-link" data-copy-link aria-live="polite">Copy link to this result</button>
    </form>

    <section class="answer" aria-label="Result" aria-live="polite">
      <div class="answer-head">
        <span class="answer-label">Charge at least</span>
        <strong class="answer-value" id="answer-value">{formatCurrency(seed.hourlyRate)}</strong>
        <p class="answer-sentence" id="answer-sentence">
          per billable hour to take home {formatCurrency(defaults.targetIncome)} a year.
        </p>
      </div>

      <div class="equation" data-label="Why">
        <span class="eq-term">
          <span class="eq-value" id="eq-revenue">{formatCurrency(seed.annualRevenueNeeded)}</span>
          <span class="eq-name">Revenue needed</span>
        </span>
        <span class="eq-op" aria-hidden="true">÷</span>
        <span class="visually-hidden">divided by</span>
        <span class="eq-term">
          <span class="eq-value" id="eq-hours">{formatNumber(seed.billableHoursPerYear)}</span>
          <span class="eq-name">Billable hours / year</span>
        </span>
        <span class="eq-op" aria-hidden="true">=</span>
        <span class="visually-hidden">equals</span>
        <span class="eq-term is-result">
          <span class="eq-value" id="eq-rate">{formatCurrency(seed.hourlyRate)}</span>
          <span class="eq-name">Hourly rate</span>
        </span>
      </div>

      <div class="answer-metrics">
        <div class="metric">
          <span class="metric-label">Day rate (8 hours)</span>
          <span class="metric-value" id="metric-day">{formatCurrency(seed.dayRate)}</span>
        </div>
        <div class="metric">
          <span class="metric-label">Estimated tax</span>
          <span class="metric-value" id="metric-tax">{formatCurrency(seed.estimatedTax)}</span>
        </div>
      </div>

      <div class="scenarios">
        <h2>At other billable hours</h2>
        <ul class="scenario-list">
          {
            scenarioHours.map((hours, index) => (
              <li>
                <span>{hours} hours / week</span>
                <span class="scenario-value" id={`scenario-${index}`}>{formatCurrency(rateAt(hours).hourlyRate)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <section class="band takeaways">
    <h2 class="band-label">What this rate means</h2>
    <ul class="takeaway-list">
      <li>
        Dividing your income by a 2,080-hour work year gives
        <strong class="figure is-negative" id="take-salary">{formatCurrency(salaryRate)}</strong> an hour — charge
        that and you'd fall well short once tax, expenses, and unbilled time are counted.
      </li>
      <li>
        You need <strong class="figure" id="take-revenue">{formatCurrency(seed.annualRevenueNeeded)}</strong> in
        billings a year, or about <strong class="figure" id="take-monthly">{formatCurrency(seed.annualRevenueNeeded / 12)}</strong>
        a month.
      </li>
      <li>
        Billable hours move the rate more than anything else. Be honest about them — time spent finding
        work, invoicing, and waiting between projects isn't billable.
      </li>
    </ul>
  </section>

  <section class="band">
    <h2 class="band-label">Hourly rate formula</h2>
    <details class="show-math" open>
      <summary><span class="chevron" aria-hidden="true"></span>Formula and worked example</summary>
      <div class="show-math-body">
        <code class="formula">revenue needed = take-home income ÷ (1 − tax rate ÷ 100) + expenses</code>
        <code class="formula">hourly rate = revenue needed ÷ (billable hours per week × working weeks)</code>
        <p>
          Tax is charged on profit — revenue minus expenses — so the income target is grossed up for tax
          first, then expenses are added on top. The day rate is the hourly rate × 8.
        </p>

        <h3>Worked example</h3>
        <dl class="example-rows">
          <div class="example-row"><dt>Take-home income</dt><dd>$75,000</dd></div>
          <div class="example-row"><dt>Grossed up for 25% tax</dt><dd>$75,000 ÷ 0.75 = $100,000</dd></div>
          <div class="example-row"><dt>Plus expenses</dt><dd>$100,000 + $10,000 = $110,000</dd></div>
          <div class="example-row"><dt>Billable hours</dt><dd>25 × 46 = 1,150</dd></div>
          <div class="example-row is-result"><dt>Hourly rate</dt><dd>$110,000 ÷ 1,150 = $95.65</dd></div>
        </dl>
      </div>
    </details>
  </section>

  <AdSlot enabled={siteConfig.ads.enabled} clientId={siteConfig.ads.clientId} slotId={siteConfig.ads.inContentSlotId} height="250px" />

  <section class="band">
    <h2 class="band-label">Freelance rate FAQ</h2>
    <FaqList faqs={faqs} />
  </section>

  <MoreTools hrefs={["/price-increase-calculator", "/break-even", "/target-profit"]} />

  <section class="band">
    <div class="band-label">Next</div>
    <NextStep
      href="/price-increase-calculator"
      title="Price Increase Calculator"
      description="Thinking of raising your rate for existing clients? See how many you could lose and still earn more."
    />
  </section>
</Layout>

<script>
  import { calculateFreelanceRate } from "@repo/calculators/freelance-rate";
  import { formatCurrency, formatNumber, readNumericField, wireCalculatorForm } from "@repo/ui";

  const form = document.getElementById("calc-form") as HTMLFormElement;
  const errorsEl = document.getElementById("form-errors") as HTMLUListElement;
  const byId = (id: string) => document.getElementById(id)!;
  const value = (id: string) => readNumericField(id);
  const scenarioHours = [20, 30, 35];

  function readInputs() {
    return {
      targetIncome: value("targetIncome"),
      annualExpenses: value("annualExpenses"),
      taxRatePercent: value("taxRatePercent"),
      billableHoursPerWeek: value("billableHoursPerWeek"),
      weeksPerYear: value("weeksPerYear"),
    };
  }

  wireCalculatorForm({
    form,
    errorsEl,
    calculatorId: "freelance-rate",
    calculate: calculateFreelanceRate,
    readInputs,
    renderResult(data) {
      const input = readInputs();
      byId("answer-value").textContent = formatCurrency(data.hourlyRate);
      byId("answer-sentence").textContent = `per billable hour to take home ${formatCurrency(input.targetIncome)} a year.`;
      byId("eq-revenue").textContent = formatCurrency(data.annualRevenueNeeded);
      byId("eq-hours").textContent = formatNumber(data.billableHoursPerYear);
      byId("eq-rate").textContent = formatCurrency(data.hourlyRate);
      byId("metric-day").textContent = formatCurrency(data.dayRate);
      byId("metric-tax").textContent = formatCurrency(data.estimatedTax);
      byId("take-salary").textContent = formatCurrency(input.targetIncome / 2080);
      byId("take-revenue").textContent = formatCurrency(data.annualRevenueNeeded);
      byId("take-monthly").textContent = formatCurrency(data.annualRevenueNeeded / 12);

      scenarioHours.forEach((hours, index) => {
        const result = calculateFreelanceRate({ ...input, billableHoursPerWeek: hours });
        byId(`scenario-${index}`).textContent = result.ok ? formatCurrency(result.data.hourlyRate) : "—";
      });
    },
  });
</script>
