---
import { buildMeta } from "@repo/seo";
import { formatCurrency, formatPercentValue } from "@repo/ui";
import AdSlot from "@repo/ui/components/AdSlot.astro";
import FaqList from "@repo/ui/components/FaqList.astro";
import Layout from "@repo/ui/components/Layout.astro";
import NextStep from "@repo/ui/components/NextStep.astro";
import { siteConfig } from "../../site.config";
import MoreTools from "../components/MoreTools.astro";
import { footerColumns, footerTagline, navItems } from "../site-nav";
import { formatUpdated, getTool, toolStructuredData } from "../tools";

const tool = getTool("/markup-margin-chart");

const meta = buildMeta(siteConfig, {
  title: "Markup to Margin Conversion Chart (and Margin to Markup)",
  description:
    "Markup to margin conversion table: see the gross margin for common markups from 10% to 400%, the markup needed for each target margin, and the formulas to convert either way.",
  path: tool.href,
});

const markupToMargin = (markup: number) => (markup / (100 + markup)) * 100;
const marginToMarkup = (margin: number) => (margin / (100 - margin)) * 100;

/** Price for a $100 cost at each markup, so each row has a concrete example. */
const markupRows = [10, 15, 20, 25, 30, 35, 40, 50, 60, 70, 75, 80, 100, 150, 200, 300, 400].map((markup) => ({
  markup,
  margin: markupToMargin(markup),
  price: 100 * (1 + markup / 100),
}));

const marginRows = [5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70, 75, 80, 90].map((margin) => ({
  margin,
  markup: marginToMarkup(margin),
  price: 100 / (1 - margin / 100),
}));

const faqs = [
  {
    question: "How do I convert markup to margin?",
    answer:
      "Divide the markup by 1 plus the markup, using decimals. A 50% markup is 0.5 ÷ 1.5 = 0.333, or a 33.3% margin. In percentages: margin = markup ÷ (100 + markup) × 100.",
  },
  {
    question: "How do I convert margin to markup?",
    answer:
      "Divide the margin by 1 minus the margin, using decimals. A 40% margin is 0.4 ÷ 0.6 = 0.667, or a 66.7% markup. In percentages: markup = margin ÷ (100 − margin) × 100.",
  },
  {
    question: "What margin is a 100% markup?",
    answer:
      "50%. Doubling the cost (a 100% markup) means half of the selling price is profit. This is the common \"keystone\" pricing rule in retail.",
  },
  {
    question: "Why is there no markup for a 100% margin?",
    answer:
      "A 100% margin would mean the item cost nothing, so the markup on a cost of zero is undefined. Margins can approach but never reach 100%, while markups can grow without limit.",
  },
  {
    question: "Which should I use — markup or margin?",
    answer:
      "Use whichever your industry quotes, but plan profit with margin, because it tells you what share of each sales dollar you keep. The danger is mixing them: applying a 30% markup when you meant a 30% margin underprices the item.",
  },
];

const structuredData = toolStructuredData(tool, meta.description);
---

<Layout
  config={siteConfig}
  meta={meta}
  structuredData={structuredData}
  navItems={navItems}
  footerColumns={footerColumns}
  footerTagline={footerTagline}
>
  <div class="page-header">
    <h1 class="page-title">{tool.name}</h1>
    <p class="lede">
      Margin = markup ÷ (100 + markup). Markup = margin ÷ (100 − margin). So a 50% markup is a 33.3%
      margin, and a 40% margin needs a 66.7% markup. Look up common values below, or use the
      <a href="/markup-vs-margin">markup vs. margin calculator</a> for any number.
    </p>
    <p class="page-meta">Updated <time datetime={tool.updated}>{formatUpdated(tool.updated)}</time> · Every figure computed from the formulas below.</p>
  </div>

  <section class="band">
    <h2 class="band-label">Markup to margin</h2>
    <div class="ref-table-wrap">
      <table class="ref-table">
        <caption>Gross margin for each markup on cost, with the selling price of an item that costs $100.</caption>
        <thead>
          <tr><th scope="col">Markup</th><th scope="col">Margin</th><th scope="col">Price on $100 cost</th></tr>
        </thead>
        <tbody>
          {
            markupRows.map((row) => (
              <tr>
                <th scope="row">{formatPercentValue(row.markup, 0)}</th>
                <td><strong>{formatPercentValue(row.margin)}</strong></td>
                <td>{formatCurrency(row.price)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="band">
    <h2 class="band-label">Margin to markup</h2>
    <div class="ref-table-wrap">
      <table class="ref-table">
        <caption>Markup needed to reach each target margin, with the selling price for a $100 cost.</caption>
        <thead>
          <tr><th scope="col">Target margin</th><th scope="col">Markup needed</th><th scope="col">Price on $100 cost</th></tr>
        </thead>
        <tbody>
          {
            marginRows.map((row) => (
              <tr>
                <th scope="row">{formatPercentValue(row.margin, 0)}</th>
                <td><strong>{formatPercentValue(row.markup)}</strong></td>
                <td>{formatCurrency(row.price)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="band">
    <h2 class="band-label">Conversion formulas</h2>
    <details class="show-math" open>
      <summary><span class="chevron" aria-hidden="true"></span>Formulas and worked example</summary>
      <div class="show-math-body">
        <code class="formula">margin % = markup % ÷ (100 + markup %) × 100</code>
        <code class="formula">markup % = margin % ÷ (100 − margin %) × 100</code>
        <p>
          Both describe the same profit. Markup divides it by cost; margin divides it by price. Because
          price is always larger than cost when there's a profit, margin is always the smaller number.
        </p>

        <h3>Worked example</h3>
        <dl class="example-rows">
          <div class="example-row"><dt>Cost · markup</dt><dd>$100 · 25%</dd></div>
          <div class="example-row"><dt>Price</dt><dd>$125</dd></div>
          <div class="example-row"><dt>Profit</dt><dd>$25</dd></div>
          <div class="example-row is-result"><dt>Margin</dt><dd>$25 ÷ $125 = 20%</dd></div>
          <div class="example-row"><dt>Formula check</dt><dd>25 ÷ 125 × 100 = 20%</dd></div>
        </dl>
      </div>
    </details>
  </section>

  <AdSlot enabled={siteConfig.ads.enabled} clientId={siteConfig.ads.clientId} slotId={siteConfig.ads.inContentSlotId} height="250px" />

  <section class="band">
    <h2 class="band-label">Markup and margin FAQ</h2>
    <FaqList faqs={faqs} />
  </section>

  <MoreTools hrefs={["/markup-vs-margin", "/selling-price", "/food-cost-calculator"]} />

  <section class="band">
    <div class="band-label">Next</div>
    <NextStep
      href="/selling-price"
      title="Selling Price Calculator"
      description="Know the margin you want? Get the exact price to charge for any cost."
    />
  </section>
</Layout>
