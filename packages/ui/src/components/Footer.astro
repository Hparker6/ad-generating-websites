---
import type { FooterColumn } from "../navigation.ts";

interface Props {
  siteName: string;
  /** Who the copyright is attributed to. */
  copyrightName: string;
  tagline?: string;
  columns?: FooterColumn[];
}

const {
  siteName,
  copyrightName,
  tagline,
  columns = [],
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="brand">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{siteName}</span>
        </span>
        {tagline && <p>{tagline}</p>}
      </div>

      {
        columns.map((column) => (
          <div class="footer-col">
            <h2>{column.heading}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {copyrightName}</span>
      <span>Calculators for planning, not financial advice.</span>
    </div>
  </div>
</footer>
